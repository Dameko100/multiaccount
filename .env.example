# Copia este archivo a .env y rellena SOLO las plataformas que vayas a usar.
# Las plataformas sin credenciales aparecen como "no configuradas" y se omiten.

PORT=4545
HOST=127.0.0.1
DEFAULT_LINK=https://limitedsniper.app

# --- YouTube (vídeo obligatorio). Obtén el refresh token con: npm run auth -- youtube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private
YOUTUBE_PRIVACY=public
# 20 = Gaming, 28 = Ciencia y tecnología
YOUTUBE_CATEGORY_ID=20

# --- TikTok (vídeo obligatorio). Obtén el refresh token con: npm run auth -- tiktok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# Debe coincidir con una "Redirect URI" registrada en tu app de TikTok (solo para npm run auth -- tiktok)
TIKTOK_REDIRECT_URI=
# direct = publica directamente | draft = lo envía a la bandeja de la app de TikTok para terminarlo allí
TIKTOK_MODE=direct
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY (apps sin auditar: solo SELF_ONLY)
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# --- X / Twitter (API v2, OAuth 1.0a con permisos de lectura y escritura) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Bluesky (usa una "App Password", no tu contraseña real) ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

# --- Mastodon ---
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Threads (Meta) ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Instagram (cuenta Business/Creator vinculada a una página de Facebook; requiere imagen o vídeo → Reel) ---
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Facebook (página) ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# --- LinkedIn (perfil urn:li:person:xxx o página urn:li:organization:xxx) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202410

# --- Reddit (app tipo "script" en https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=
REDDIT_USER_AGENT=multiaccount/1.0 (by u/tu_usuario)

# --- Telegram (bot administrador del canal) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@tu_canal

# --- Discord (webhook del canal de anuncios) ---
DISCORD_WEBHOOK_URL=
