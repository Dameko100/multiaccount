# Copia este archivo a .env y rellena SOLO las plataformas que vayas a usar.
# Las plataformas sin credenciales aparecen como "no configuradas" y se omiten.

PORT=4545
HOST=127.0.0.1
DEFAULT_LINK=https://limitedsniper.app

# --- X / Twitter (API v2, OAuth 1.0a con permisos de lectura y escritura) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Bluesky (usa una "App Password", no tu contraseña real) ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

# --- Mastodon ---
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Threads (Meta) ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Instagram (cuenta Business/Creator vinculada a una página de Facebook; requiere imagen) ---
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Facebook (página) ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# --- LinkedIn (perfil urn:li:person:xxx o página urn:li:organization:xxx) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202410

# --- Reddit (app tipo "script" en https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=
REDDIT_USER_AGENT=multiaccount/1.0 (by u/tu_usuario)

# --- Telegram (bot administrador del canal) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@tu_canal

# --- Discord (webhook del canal de anuncios) ---
DISCORD_WEBHOOK_URL=
